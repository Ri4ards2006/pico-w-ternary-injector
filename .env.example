# Copy to `.env` (git-ignored) and fill in. Read by build.rs at compile time.
# Exported shell variables take precedence over this file.

# 2.4 GHz network the Pico W joins (CYW43439 has no 5 GHz radio).
WIFI_SSID=your-ssid-here
# WPA2/WPA3 passphrase; leave empty for an open network.
WIFI_PSK=your-passphrase-here

# TCP port the injector listens on (default 7878).
TCP_PORT=7878
